# EMMI with PBMETAD reweighting and on-the-fly uncertainty in the mean estimate (OPTSIGMAMEAN), two GMM groups,
# Monte Carlo of sigma with the total uncertainty (SEED for reproducibility)
MOLINFO STRUCTURE=structure.pdb
WHOLEMOLECULES  ENTITY0=1-22 ADDREFERENCE

protein-h: GROUP NDX_FILE=index.ndx NDX_GROUP=Protein-H

phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17

PBMETAD ...
    BIASFACTOR=8 HEIGHT=2.0 PACE=1 WALKERS_MPI LABEL=pb
    ARG=phi,psi SIGMA=0.3,0.3 TEMP=310
...

EMMI ...
    REWEIGHT ARG=pb.bias AVERAGING=5
    OPTSIGMAMEAN SIGMA_MEAN0=0.05
    LABEL=gmm NOPBC TEMP=310 NL_STRIDE=10 NL_CUTOFF=0.1
    ATOMS=protein-h GMM_FILE=map.dat
    WRITE_STRIDE=10
    SIGMA0=0.5 SIGMA_MIN=0.2 DSIGMA=0.05 SEED=1234 RESOLUTION=1.0 NOISETYPE=GAUSS
...

DUMPDERIVATIVES ARG=gmm.scoreb STRIDE=1 FMT=%8.1f FILE=deriva
PRINT ARG=gmm.scoreb,gmm.sigmaMean-0,gmm.sigmaMean-1,gmm.sigma-0,gmm.sigma-1,gmm.acc,gmm.weight,gmm.neff FILE=GMM STRIDE=1 FMT=%10.4f
